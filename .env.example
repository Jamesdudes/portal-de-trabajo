# PORT: El puerto en el que escucha el servidor HTTP nativo de Node.js (por defecto 3000).
PORT=3000

# MONGODB_URI: URI de conexión a la instancia de MongoDB (local o Atlas).
MONGODB_URI="mongodb://127.0.0.1:27017/portal_trabajo"

# MONGODB_DB: Nombre de la base de datos principal utilizada por el Portal de Trabajo.
MONGODB_DB="portal_trabajo"

